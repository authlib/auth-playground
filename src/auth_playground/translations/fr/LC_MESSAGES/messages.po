#: src/auth_playground/templates/policy.html:21
msgid "What Data Is Handled"
msgstr "Quelles données sont traitées"

#: src/auth_playground/templates/policy.html:23
msgid ""
"When you authenticate through Auth Playground, the following information "
"is received from your identity provider:"
msgstr ""
"Lorsque vous vous authentifiez via Auth Playground, les informations "
"suivantes sont reçues de votre fournisseur d'identité :"

#: src/auth_playground/templates/policy.html:27
msgid "Access token:"
msgstr "Jeton d'accès :"

#: src/auth_playground/templates/policy.html:27
msgid "Used to access protected resources"
msgstr "Utilisé pour accéder aux ressources protégées"

#: src/auth_playground/templates/policy.html:28
msgid "Refresh token:"
msgstr "Jeton de rafraîchissement :"

#: src/auth_playground/templates/policy.html:28
msgid "Used to obtain new access tokens (if provided)"
msgstr "Utilisé pour obtenir de nouveaux jetons d'accès (si fourni)"

#: src/auth_playground/templates/policy.html:29
msgid "ID token:"
msgstr "Jeton d'identité :"

