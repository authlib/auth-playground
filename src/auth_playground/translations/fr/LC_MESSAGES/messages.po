#: src/auth_playground/__init__.py:288
#, python-format
msgid "This request should be sent to %(server_name)s"
msgstr "Cette requête doit être envoyée à %(server_name)s"

#: src/auth_playground/client_key.py:76
msgid "This is a public key. Paste the private key."
msgstr "C'est une clé publique. Collez la clé privée."

#: src/auth_playground/client_key.py:87
msgid "This key is not meant for signing."
msgstr "Cette clé n'est pas prévue pour signer."

#: src/auth_playground/client_key.py:92
#, python-brace-format
msgid "The playground cannot sign with this key for {alg}."
msgstr "Le playground ne peut pas signer avec cette clé pour {alg}."

#: src/auth_playground/client_key.py:96
msgid "The playground cannot sign with this key."
msgstr "Le playground ne peut pas signer avec cette clé."

#: src/auth_playground/client_key.py:105
msgid "This JWK is not valid JSON."
msgstr "Ce JWK n'est pas un JSON valide."

#: src/auth_playground/client_key.py:108
msgid "The JWK must be an RSA, EC or OKP key."
msgstr "Le JWK doit être une clé RSA, EC ou OKP."

#: src/auth_playground/client_key.py:114
#, python-brace-format
msgid "This JWK is not valid: {error}"
msgstr "Ce JWK n'est pas valide : {error}"

#: src/auth_playground/client_key.py:123
msgid "This is not an RSA, EC or Ed25519 key in PEM format."
msgstr "Ce n'est pas une clé RSA, EC ou Ed25519 au format PEM."

#: src/auth_playground/endpoints.py:90
msgid "The server metadata has no issuer."
msgstr "Les métadonnées du serveur n'ont pas de champ issuer."

#: src/auth_playground/endpoints.py:93
#, python-brace-format
msgid ""
"The issuer of the server metadata is {issuer}, not the URL you entered. A"
" server must not use the issuer of another one."
msgstr ""
"L'issuer des métadonnées du serveur est {issuer}, et non l'URL saisie. Un"
" serveur ne doit pas utiliser l'issuer d'un autre."

#: src/auth_playground/endpoints.py:97
msgid "Cannot connect to the server. Please check the URL."
msgstr "Impossible de se connecter au serveur. Veuillez vérifier l'URL."

#: src/auth_playground/endpoints.py:99
msgid "Connection timeout. The server is not responding."
msgstr "Délai de connexion dépassé. Le serveur ne répond pas."

#: src/auth_playground/endpoints.py:103
msgid ""
"This server does not support OIDC Discovery or OAuth 2.0 Authorization "
"Server Metadata"
msgstr ""
"Ce serveur ne prend pas en charge OIDC Discovery ou les métadonnées du "
"serveur d'autorisation OAuth 2.0"

#: src/auth_playground/endpoints.py:105
#, python-brace-format
msgid "Server returned an error: HTTP {status_code}"
msgstr "Le serveur a renvoyé une erreur : HTTP {status_code}"

#: src/auth_playground/endpoints.py:109
msgid "Invalid response from server"
msgstr "Réponse invalide du serveur"

#: src/auth_playground/endpoints.py:111
msgid "Failed to connect to the server. Please check the URL."
msgstr "Échec de connexion au serveur. Veuillez vérifier l'URL."

#: src/auth_playground/endpoints.py:113
msgid "Cannot load the server metadata."
msgstr "Impossible de charger les métadonnées du serveur."

#: src/auth_playground/endpoints.py:195
msgid "A provider is already set. Change it to use another one."
msgstr "Un fournisseur est déjà configuré. Changez-le pour en utiliser un autre."

#: src/auth_playground/endpoints.py:243 src/auth_playground/endpoints.py:342
#: src/auth_playground/oauth.py:164 src/auth_playground/oauth.py:352
#: src/auth_playground/oauth.py:604 src/auth_playground/oauth.py:802
#: src/auth_playground/oauth.py:878 src/auth_playground/oauth.py:942
msgid "Invalid request"
msgstr "Requête invalide"

#: src/auth_playground/endpoints.py:311 src/auth_playground/oauth.py:153
msgid "A client is already set. Change it to use another one."
msgstr "Un client est déjà configuré. Changez-le pour en utiliser un autre."

#: src/auth_playground/endpoints.py:391
msgid "No server configured"
msgstr "Aucun serveur configuré"

#: src/auth_playground/forms.py:180 src/auth_playground/forms.py:191
msgid "Default"
msgstr "Par défaut"

#: src/auth_playground/forms.py:181
msgid "None - No UI"
msgstr "Aucune - Pas d'interface"

#: src/auth_playground/forms.py:182
msgid "Login - Authentication page"
msgstr "Connexion - Page d'authentification"

#: src/auth_playground/forms.py:183
msgid "Consent - Consent page"
msgstr "Consentement - Page de consentement"

#: src/auth_playground/forms.py:184
msgid "Select account - Account selection page"
msgstr "Choix du compte - Page de sélection du compte"

#: src/auth_playground/forms.py:185
msgid "Create - Registration page"
msgstr "Création - Page d'inscription"

#: src/auth_playground/forms.py:219
msgid "Renew tokens"
msgstr "Renouveler les jetons"

#: src/auth_playground/forms.py:225
msgid "Get user info"
msgstr "Obtenir les informations utilisateur"

#: src/auth_playground/forms.py:241
msgid "URL must start with http:// or https://"
msgstr "L'URL doit commencer par http:// ou https://"

#: src/auth_playground/forms.py:254
msgid ""
"HTTP is only allowed for localhost or in debug/testing mode. Use HTTPS in"
" production."
msgstr ""
"HTTP n'est autorisé que pour localhost ou en mode débogage/test. Utilisez"
" HTTPS en production."

#: src/auth_playground/forms.py:263
msgid "Provider URL:"
msgstr "URL du fournisseur :"

#: src/auth_playground/forms.py:265
msgid "Provider URL is required"
msgstr "L'URL du fournisseur est requise"

#: src/auth_playground/forms.py:274
#: src/auth_playground/templates/form_post_relay.html:21
msgid "Continue"
msgstr "Continuer"

#: src/auth_playground/forms.py:281
#, python-brace-format
msgid "{value} (not advertised)"
msgstr "{value} (non annoncé)"

#: src/auth_playground/forms.py:346
#: src/auth_playground/templates/configure_client.html:56
msgid "JSON, not signed"
msgstr "JSON, non signée"

#: src/auth_playground/forms.py:348
#, python-brace-format
msgid "Signed with {alg}"
msgstr "Signée avec {alg}"

#: src/auth_playground/forms.py:357
#: src/auth_playground/templates/configure_client.html:51
msgid "UserInfo response:"
msgstr "Réponse UserInfo :"

#: src/auth_playground/forms.py:360
msgid "A signed response is a JWT, and Authlib checks its signature."
msgstr "Une réponse signée est un JWT, et Authlib vérifie sa signature."

#: src/auth_playground/forms.py:421
msgid "Client key:"
msgstr "Clé du client :"

#: src/auth_playground/forms.py:423
msgid "Generate a key"
msgstr "Générer une clé"

#: src/auth_playground/forms.py:424
msgid "Import a key"
msgstr "Importer une clé"

#: src/auth_playground/forms.py:428
msgid "The client signs its token requests with this key."
msgstr "Le client signe ses requêtes de jetons avec cette clé."

#: src/auth_playground/forms.py:431
msgid "Private key:"
msgstr "Clé privée :"

#: src/auth_playground/forms.py:434
msgid "PEM or JWK: RSA, EC or Ed25519. Kept in your session, never shown again."
msgstr ""
"PEM ou JWK : RSA, EC ou Ed25519. Gardée dans votre session, jamais "
"réaffichée."

#: src/auth_playground/forms.py:444
msgid "Key ID (kid):"
msgstr "ID de clé (kid) :"

#: src/auth_playground/forms.py:447
msgid ""
"Sent in the assertion header. Leave empty to use the key thumbprint (RFC "
"7638)."
msgstr ""
"Envoyé dans l'en-tête de l'assertion. Laissez vide pour utiliser "
"l'empreinte de la clé (RFC 7638)."

#: src/auth_playground/forms.py:452
msgid "Signing algorithm:"
msgstr "Algorithme de signature :"

#: src/auth_playground/forms.py:455
msgid "From token_endpoint_auth_signing_alg_values_supported."
msgstr "D'après token_endpoint_auth_signing_alg_values_supported."

#: src/auth_playground/forms.py:459
msgid "Generate another key"
msgstr "Générer une autre clé"

#: src/auth_playground/forms.py:546
msgid "Paste the private key of the client."
msgstr "Collez la clé privée du client."

#: src/auth_playground/forms.py:557 src/auth_playground/forms.py:1185
#: src/auth_playground/templates/configure_client.html:37
msgid "Client ID:"
msgstr "ID du client :"

#: src/auth_playground/forms.py:559
msgid "Client ID is required"
msgstr "L'ID du client est requis"

#: src/auth_playground/forms.py:563
msgid "Client ID must be between 1 and 255 characters"
msgstr "L'ID du client doit contenir entre 1 et 255 caractères"

#: src/auth_playground/forms.py:569 src/auth_playground/forms.py:630
#: src/auth_playground/templates/configure_client.html:41
msgid "Token endpoint authentication:"
msgstr "Authentification à l'endpoint de jetons :"

#: src/auth_playground/forms.py:572
msgid "How the client proves its identity to the token endpoint."
msgstr "Comment le client prouve son identité à l'endpoint de jetons."

#: src/auth_playground/forms.py:576
msgid "Client secret:"
msgstr "Secret du client :"

#: src/auth_playground/forms.py:577
msgid "Leave empty for a public client."
msgstr "Laissez vide pour un client public."

#: src/auth_playground/forms.py:589
msgid "Complete configuration"
msgstr "Terminer la configuration"

#: src/auth_playground/forms.py:608
msgid "This authentication method needs a client secret."
msgstr "Cette méthode d'authentification nécessite un secret client."

#: src/auth_playground/forms.py:614
msgid "A public client has no secret. Leave the secret empty."
msgstr "Un client public n'a pas de secret. Laissez le secret vide."

#: src/auth_playground/forms.py:622
msgid "Client type:"
msgstr "Type de client :"

#: src/auth_playground/forms.py:624
msgid "Confidential, with a secret or a key"
msgstr "Confidentiel, avec un secret ou une clé"

#: src/auth_playground/forms.py:625
msgid "Public, without a secret, with PKCE"
msgstr "Public, sans secret, avec PKCE"

#: src/auth_playground/forms.py:633
msgid "A public client uses none."
msgstr "Un client public utilise none."

#: src/auth_playground/forms.py:647
msgid "Public key sent to the provider:"
msgstr "Clé publique envoyée au fournisseur :"

#: src/auth_playground/forms.py:649
msgid "jwks: the key goes in the registration request"
msgstr "jwks : la clé est dans la requête d'enregistrement"

#: src/auth_playground/forms.py:653
msgid ""
"jwks_uri: the provider downloads the key from the playground, which must "
"be reachable from the provider"
msgstr ""
"jwks_uri : le fournisseur télécharge la clé depuis le playground, qui "
"doit lui être accessible"

#: src/auth_playground/forms.py:665
msgid "Grant types to register:"
msgstr "Types de grant à enregistrer :"

#: src/auth_playground/forms.py:673
msgid "Initial access token:"
msgstr "Jeton d'accès initial :"

#: src/auth_playground/forms.py:676
msgid "Leave empty if not required"
msgstr "Laisser vide si non requis"

#: src/auth_playground/forms.py:680
msgid "Register client"
msgstr "Enregistrer le client"

#: src/auth_playground/forms.py:698
msgid "Choose at least one grant type."
msgstr "Choisissez au moins un type de grant."

#: src/auth_playground/forms.py:704
msgid "Change provider"
msgstr "Changer de fournisseur"

#: src/auth_playground/forms.py:710
msgid "Unregister client"
msgstr "Désinscrire le client"

#: src/auth_playground/forms.py:716
msgid "Log out here"
msgstr "Se déconnecter ici"

#: src/auth_playground/forms.py:722
msgid "Change client"
msgstr "Changer de client"

#: src/auth_playground/forms.py:729
msgid "Disabled"
msgstr "Désactivé"

#: src/auth_playground/forms.py:744
msgid "Default (query)"
msgstr "Par défaut (query)"

#: src/auth_playground/forms.py:799
msgid "Scopes:"
msgstr "Portées :"

#: src/auth_playground/forms.py:802
msgid "Select the scopes to request from the authorization server."
msgstr "Sélectionnez les portées à demander au serveur d'autorisation."

#: src/auth_playground/forms.py:830
msgid "Other scopes:"
msgstr "Autres portées :"

#: src/auth_playground/forms.py:831
msgid "Space-separated, sent as they are."
msgstr "Séparées par des espaces, envoyées telles quelles."

#: src/auth_playground/forms.py:835
msgid "Extra parameters:"
msgstr "Paramètres supplémentaires :"

#: src/auth_playground/forms.py:836
msgid "One name=value per line, added to the request as they are."
msgstr "Un nom=valeur par ligne, ajoutés tels quels à la requête."

#: src/auth_playground/forms.py:849
#, python-brace-format
msgid ""
"Each line must be name=value, with a parameter the playground does not "
"set itself: {errors}"
msgstr ""
"Chaque ligne doit être de la forme nom=valeur, avec un paramètre que le "
"playground ne fixe pas lui-même : {errors}"

#: src/auth_playground/forms.py:861
#: src/auth_playground/templates/_tokens.html:18
msgid "PKCE:"
msgstr "PKCE :"

#: src/auth_playground/forms.py:865
msgid "Sends a code_challenge here, and the code_verifier with the token request."
msgstr ""
"Envoie un code_challenge ici, et le code_verifier avec la requête de "
"jetons."

#: src/auth_playground/forms.py:871
msgid "Response mode:"
msgstr "Mode de réponse :"

#: src/auth_playground/forms.py:875
msgid ""
"form_post: the provider posts the response to the playground, instead of "
"putting it in the URL."
msgstr ""
"form_post : le fournisseur envoie la réponse au playground par un POST, "
"au lieu de la mettre dans l'URL."

#: src/auth_playground/forms.py:881
msgid "Prompt:"
msgstr "Invite :"

#: src/auth_playground/forms.py:883
msgid "What the provider shows to the user."
msgstr "Ce que le fournisseur montre à l'utilisateur."

#: src/auth_playground/forms.py:887 src/auth_playground/forms.py:1200
msgid "UI locales:"
msgstr "Langues de l'interface :"

#: src/auth_playground/forms.py:890
msgid "Preferred language for the authentication UI."
msgstr "Langue préférée pour l'interface d'authentification."

#: src/auth_playground/forms.py:894
msgid "Max age (seconds):"
msgstr "Âge maximum (secondes) :"

#: src/auth_playground/forms.py:897
msgid ""
"Maximum authentication age. 0 forces re-authentication and refreshes "
"auth_time."
msgstr ""
"Âge maximum de l'authentification. 0 force la réauthentification et met à"
" jour auth_time."

#: src/auth_playground/forms.py:902
msgid "ACR values:"
msgstr "Valeurs ACR :"

#: src/auth_playground/forms.py:904
msgid ""
"Requested authentication context classes, space-separated (step-up "
"authentication)."
msgstr ""
"Classes de contexte d'authentification demandées, séparées par des "
"espaces (authentification renforcée)."

#: src/auth_playground/forms.py:909
msgid "Login hint:"
msgstr "Indice de connexion :"

#: src/auth_playground/forms.py:910
msgid "Identifier to pre-fill on the provider's login screen."
msgstr "Identifiant à pré-remplir sur l'écran de connexion du fournisseur."

#: src/auth_playground/forms.py:914
msgid "Claims (JSON):"
msgstr "Claims (JSON) :"

#: src/auth_playground/forms.py:916
msgid "Specific claims to request, as an OIDC claims JSON object (advanced)."
msgstr ""
"Claims spécifiques à demander, sous forme d'objet JSON claims OIDC "
"(avancé)."

#: src/auth_playground/forms.py:921
msgid "Authorization request"
msgstr "Requête d'autorisation"

#: src/auth_playground/forms.py:923
msgid "Sign in"
msgstr "Se connecter"

#: src/auth_playground/forms.py:935
msgid "Claims must be a JSON object."
msgstr "Les claims doivent être un objet JSON."

#: src/auth_playground/forms.py:946 src/auth_playground/forms.py:971
#: src/auth_playground/forms.py:1107
msgid "Token request"
msgstr "Requête de jetons"

#: src/auth_playground/forms.py:948 src/auth_playground/forms.py:973
#: src/auth_playground/forms.py:1112
#: src/auth_playground/templates/request.html:5
msgid "Request tokens"
msgstr "Demander des jetons"

#: src/auth_playground/forms.py:959
msgid "Username:"
msgstr "Nom d'utilisateur :"

#: src/auth_playground/forms.py:964
msgid "Password:"
msgstr "Mot de passe :"

#: src/auth_playground/forms.py:990
#, python-brace-format
msgid "Sign with the client key: {alg}"
msgstr "Signer avec la clé du client : {alg}"

#: src/auth_playground/forms.py:994
msgid "Sign with the client key: this client has none."
msgstr "Signer avec la clé du client : ce client n'en a pas."

#: src/auth_playground/forms.py:996
#, python-brace-format
msgid "Sign with the client secret: {alg}"
msgstr "Signer avec le secret du client : {alg}"

#: src/auth_playground/forms.py:1000
msgid "Sign with the client secret: this client has none."
msgstr "Signer avec le secret du client : ce client n'en a pas."

#: src/auth_playground/forms.py:1012
msgid "Paste an assertion issued elsewhere"
msgstr "Coller une assertion émise ailleurs"

#: src/auth_playground/forms.py:1037
#, python-brace-format
msgid "{url} (issuer)"
msgstr "{url} (issuer)"

#: src/auth_playground/forms.py:1041
#, python-brace-format
msgid "{url} (token endpoint)"
msgstr "{url} (endpoint de jetons)"

#: src/auth_playground/forms.py:1053
msgid "Assertion:"
msgstr "Assertion :"

#: src/auth_playground/forms.py:1058
msgid ""
"A client gets a key with private_key_jwt, and a secret with the other "
"confidential methods."
msgstr ""
"Un client a une clé avec private_key_jwt, et un secret avec les autres "
"méthodes confidentielles."

#: src/auth_playground/forms.py:1063
msgid "Assertion (JWT):"
msgstr "Assertion (JWT) :"

#: src/auth_playground/forms.py:1065
msgid ""
"Sent as is. The playground only decodes it, it does not check the "
"signature."
msgstr ""
"Envoyée telle quelle. Le playground la décode seulement, il ne vérifie "
"pas la signature."

#: src/auth_playground/forms.py:1076
msgid "Subject (sub):"
msgstr "Sujet (sub) :"

#: src/auth_playground/forms.py:1079
msgid "Who the tokens are for. Filled with the sub of the signed-in user."
msgstr ""
"À qui sont destinés les jetons. Rempli avec le sub de l'utilisateur "
"connecté."

#: src/auth_playground/forms.py:1084
msgid "Issuer (iss):"
msgstr "Émetteur (iss) :"

#: src/auth_playground/forms.py:1086
msgid "The client ID, unless another party issues the assertion."
msgstr "L'ID du client, sauf si un tiers émet l'assertion."

#: src/auth_playground/forms.py:1089
msgid "Audience (aud):"
msgstr "Audience (aud) :"

#: src/auth_playground/forms.py:1092
msgid "Per RFC 10070 §4, both are allowed for a grant."
msgstr "Selon la RFC 10070 §4, les deux valeurs sont acceptées pour un grant."

#: src/auth_playground/forms.py:1095
msgid "Lifetime (seconds):"
msgstr "Durée de vie (secondes) :"

#: src/auth_playground/forms.py:1097
msgid "From now to exp."
msgstr "De maintenant jusqu'à exp."

#: src/auth_playground/forms.py:1101
msgid "Extra claims:"
msgstr "Claims supplémentaires :"

#: src/auth_playground/forms.py:1102
msgid "A JSON object, added to the claims above."
msgstr "Un objet JSON, ajouté aux claims ci-dessus."

#: src/auth_playground/forms.py:1110
#: src/auth_playground/templates/_grant_jwt_bearer.html:6
msgid "Assertion"
msgstr "Assertion"

#: src/auth_playground/forms.py:1134
msgid "This client cannot sign the assertion this way."
msgstr "Ce client ne peut pas signer l'assertion de cette façon."

#: src/auth_playground/forms.py:1138
msgid "Paste the assertion."
msgstr "Collez l'assertion."

#: src/auth_playground/forms.py:1142
msgid "Enter who the tokens are for."
msgstr "Indiquez à qui sont destinés les jetons."

#: src/auth_playground/forms.py:1146
msgid "Enter who issues the assertion."
msgstr "Indiquez qui émet l'assertion."

#: src/auth_playground/forms.py:1154
msgid "Enter a number of seconds, 1 or more."
msgstr "Saisissez un nombre de secondes, 1 ou plus."

#: src/auth_playground/forms.py:1162
msgid "The extra claims must be a JSON object."
msgstr "Les claims supplémentaires doivent être un objet JSON."

#: src/auth_playground/forms.py:1165
#, python-brace-format
msgid "The form already sets these claims: {claims}."
msgstr "Le formulaire fixe déjà ces claims : {claims}."

#: src/auth_playground/forms.py:1178
msgid "ID token hint:"
msgstr "Indice de jeton d'identité :"

#: src/auth_playground/forms.py:1180
msgid "The ID token from the sign-in. It tells the provider which session to end."
msgstr ""
"Le jeton d'identité de la connexion. Il indique au fournisseur quelle "
"session terminer."

#: src/auth_playground/forms.py:1186
msgid "The ID of the client."
msgstr "L'ID du client."

#: src/auth_playground/forms.py:1190
msgid "Post-logout redirect URI:"
msgstr "URI de redirection après déconnexion :"

#: src/auth_playground/forms.py:1191
msgid "Where the provider sends the browser after the logout."
msgstr "Où le fournisseur renvoie le navigateur après la déconnexion."

#: src/auth_playground/forms.py:1195
msgid "Logout hint:"
msgstr "Indice de déconnexion :"

#: src/auth_playground/forms.py:1196
msgid "Which user to log out, when the ID token hint is empty."
msgstr "Quel utilisateur déconnecter, quand l'indice de jeton d'identité est vide."

#: src/auth_playground/forms.py:1202
msgid "Preferred language for the logout UI."
msgstr "Langue préférée pour l'interface de déconnexion."

#: src/auth_playground/forms.py:1206
msgid "Logout request"
msgstr "Requête de déconnexion"

#: src/auth_playground/forms.py:1209
msgid "Log out at the provider"
msgstr "Se déconnecter chez le fournisseur"

#: src/auth_playground/grants.py:39
msgid "Redirect"
msgstr "Redirection"

#: src/auth_playground/grants.py:41
msgid ""
"The user signs in at the provider, which sends them back to the "
"playground."
msgstr ""
"L'utilisateur se connecte chez le fournisseur, qui le renvoie vers le "
"playground."

#: src/auth_playground/grants.py:46
msgid "Direct"
msgstr "Direct"

#: src/auth_playground/grants.py:48
msgid ""
"The playground calls the token endpoint itself, without a browser "
"redirection."
msgstr ""
"Le playground appelle lui-même l'endpoint de jetons, sans redirection du "
"navigateur."

#: src/auth_playground/grants.py:94
msgid "Deprecated"
msgstr "Déconseillé"

#: src/auth_playground/grants.py:96
msgid "Not advertised"
msgstr "Non annoncé"

#: src/auth_playground/grants.py:98
msgid "Not registered"
msgstr "Non enregistré"

#: src/auth_playground/grants.py:105
msgid "Authorization code"
msgstr "Code d'autorisation"

#: src/auth_playground/grants.py:108
msgid ""
"The user signs in at the provider, which redirects back with a code. The "
"playground then exchanges the code for tokens at the token endpoint. "
"Signing in again updates auth_time, acr and amr."
msgstr ""
"L'utilisateur se connecte chez le fournisseur, qui le redirige avec un "
"code. Le playground échange ensuite ce code contre des jetons à "
"l'endpoint de jetons. Se reconnecter met à jour auth_time, acr et amr."

#: src/auth_playground/grants.py:123
msgid "Client credentials"
msgstr "Identifiants du client"

